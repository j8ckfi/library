{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Machine Learning Knowledge Graph Schema",
  "description": "Schema for nodes and edges in the j8ckfi/library ML SOTA graph",
  "definitions": {
    "node_type": {
      "type": "string",
      "enum": ["task", "method", "paper", "recipe"]
    },
    "sota_claim": {
      "type": "object",
      "required": ["benchmark", "metric", "value", "date"],
      "properties": {
        "benchmark": { "type": "string" },
        "metric": { "type": "string" },
        "value": { "type": ["string", "number"] },
        "baseline": { "type": "string" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$" },
        "verified": { "type": "boolean" },
        "evidence_level": {
          "type": "string",
          "enum": ["peer-reviewed", "preprint", "self-reported", "unofficial-repro"]
        },
        "source_url": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "task_sota_entry": {
      "type": "object",
      "required": ["method", "as_of", "benchmark", "metric", "value"],
      "properties": {
        "method": { "type": "string", "pattern": "^method:" },
        "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$" },
        "benchmark": { "type": "string" },
        "metric": { "type": "string" },
        "value": { "type": ["string", "number"] },
        "notes": { "type": "string" }
      }
    },
    "task_node": {
      "type": "object",
      "required": ["id", "type", "title", "domain", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^task:[a-z0-9-_]+$" },
        "type": { "type": "string", "const": "task" },
        "title": { "type": "string" },
        "domain": { "type": "string" },
        "summary": { "type": "string" },
        "scope": { "type": "string" },
        "out_of_scope": { "type": "array", "items": { "type": "string" } },
        "redirects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["when", "to"],
            "properties": {
              "when": { "type": "string" },
              "to": { "type": "string", "pattern": "^(task|method):" }
            }
          }
        },
        "last_reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "current_sota": {
          "type": "array",
          "items": { "$ref": "#/definitions/task_sota_entry" }
        },
        "methods": {
          "type": "array",
          "items": { "type": "string", "pattern": "^method:" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "method_node": {
      "type": "object",
      "required": ["id", "type", "title", "category", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^method:[a-z0-9-_.]+$" },
        "type": { "type": "string", "const": "method" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["sota", "active", "superseded", "niche", "experimental"]
        },
        "sota_for": {
          "type": "array",
          "items": { "type": "string", "pattern": "^task:" }
        },
        "supersedes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^method:" }
        },
        "superseded_by": {
          "type": "string",
          "pattern": "^method:"
        },
        "do_not_use_for": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["when", "reason"],
            "properties": {
              "when": { "type": "string" },
              "reason": { "type": "string" },
              "use_instead": { "type": "string", "pattern": "^(method|task):" }
            }
          }
        },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "last_reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "papers": {
          "type": "array",
          "items": { "type": "string", "pattern": "^paper:" }
        },
        "recipes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^recipe:" }
        },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/definitions/sota_claim" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "paper_node": {
      "type": "object",
      "required": ["id", "type", "title", "authors", "year", "month", "arxiv_id", "url"],
      "properties": {
        "id": { "type": "string", "pattern": "^paper:[a-z0-9-_.]+$" },
        "type": { "type": "string", "const": "paper" },
        "title": { "type": "string" },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "year": { "type": "integer" },
        "month": { "type": "integer" },
        "arxiv_id": { "type": "string" },
        "url": { "type": "string" },
        "methods": {
          "type": "array",
          "items": { "type": "string", "pattern": "^method:" }
        },
        "cites": {
          "type": "array",
          "items": { "type": "string", "pattern": "^paper:" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "recipe_node": {
      "type": "object",
      "required": ["id", "type", "title", "method", "task", "framework", "repo_url"],
      "properties": {
        "id": { "type": "string", "pattern": "^recipe:[a-z0-9-_.]+$" },
        "type": { "type": "string", "const": "recipe" },
        "title": { "type": "string" },
        "method": { "type": "string", "pattern": "^method:" },
        "task": { "type": "string", "pattern": "^task:" },
        "target_hardware": { "type": "string" },
        "framework": { "type": "string" },
        "repo_url": { "type": "string" },
        "pip_dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
